# UC Central — example environment file.
# Copy to `.env` and adjust for local development.
# In production these values are injected by the Databricks App runtime
# (Lakebase database binding) — see DEPLOYMENT.md and MANIFESTO.md.

# CONFIGURE(pg-app-name): the Lakebase instance name used in LOCAL development.
# In production this is injected by the app `database` binding from the bundle's
# `instance_name` variable (see databricks.yml). The value here only affects
# local dev (where APX_DEV_DB_PORT is set); it does NOT change the deploy binding.
PGAPPNAME=permissions-app
