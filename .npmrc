# Make `npm install` reproduce the working graph that `bun install` (bun.lock)
# already builds and runs the app with.
#
# This project resolves JS deps with bun. bun accepts an unmet OPTIONAL peer
# (peerDependenciesMeta.optional). npm v7+ instead errors (ERESOLVE) when an
# optional peer IS present in the tree but at a version outside its declared
# range. That happens here: @tanstack/router-plugin (a build-time Vite
# devDependency) optionally peers on @tanstack/react-router, and the pinned
# react-router 1.145.7 falls outside the plugin's optional range.
#
# legacy-peer-deps makes npm ignore peer conflicts entirely — matching bun's
# lenient optional-peer resolution — so `npm install` succeeds with the SAME
# versions bun uses. This flag changes peer-resolution STRICTNESS only; it does
# not alter any dependency version.
legacy-peer-deps=true
